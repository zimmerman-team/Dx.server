{
  "name": "data-explorer-server",
  "version": "1.0.0",
  "private": true,
  "description": "data-explorer-server",
  "keywords": [
    "data-explorer-server",
    "api",
    "middleware",
    "data",
    "the-global-fund"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": "18 || 20 || 22"
  },
  "scripts": {
    "build": "lb-tsc",
    "build:watch": "lb-tsc --watch",
    "lint": "yarn run eslint && yarn run prettier:check",
    "lint:fix": "yarn run eslint:fix && yarn run prettier:fix",
    "prettier:cli": "lb-prettier \"**/*.ts\" \"**/*.js\"",
    "prettier:check": "yarn run prettier:cli -l",
    "prettier:fix": "yarlin run prettier:cli --write",
    "eslint": "lb-eslint --report-unused-disable-directives .",
    "eslint:fix": "yarn run eslint --fix",
    "premigrate": "yarn run build",
    "migrate": "node ./dist/migrate",
    "prestart": "yarn run rebuild",
    "start": "node -r source-map-support/register .",
    "clean": "lb-clean dist *.tsbuildinfo .eslintcache",
    "rebuild": "yarn run clean && yarn run build",
    "dev": "nodemon --trace-deprecation",
    "deploy": "yarn prestart && pm2 start pm2.config.js --env production",
    "initialise-server": "cd src/utils/renderChart/ && npx webpack --config webpack.config.cjs && cd ../../..",
    "rebuild-ssr": "cd src/utils/renderChart/ && npx webpack --config webpack.config.cjs && cd ../../..",
    "docker": "yarn prestart && yarn migrate && pm2-runtime start pm2.config.js --env production"
  },
  "nodemonConfig": {
    "verbose": true,
    "watch": [
      "src/"
    ],
    "ignore": [
      "dist/*",
      "src/utils/renderChart/dist/rendering/*",
      "src/logging/*"
    ],
    "ext": "ts",
    "exec": "npm start"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/globalfund/data-explorer-server.git"
  },
  "files": [
    "README.md",
    "dist",
    "src",
    "!*/__tests__"
  ],
  "dependencies": {
    "@loopback/authentication": "^11.0.7",
    "@loopback/boot": "^7.0.6",
    "@loopback/core": "^6.1.3",
    "@loopback/logging": "^0.13.12",
    "@loopback/repository": "^7.0.6",
    "@loopback/rest": "^14.0.6",
    "@loopback/rest-explorer": "^7.0.6",
    "@loopback/security": "^0.12.12",
    "@loopback/service-proxy": "^7.0.6",
    "@rawgraphs/rawgraphs-core": "^1.0.0-beta.17",
    "@turf/center": "^6.5.0",
    "@turf/helpers": "^6.5.0",
    "@types/memory-cache": "^0.2.5",
    "axios": "^0.24.0",
    "bson": "5.0.0",
    "bull": "^4.13.0",
    "dotenv": "^16.0.1",
    "express-jwt": "^6.1.0",
    "express-jwt-authz": "^2.4.1",
    "jsdom": "^29.0.2",
    "jwks-rsa": "^2.0.5",
    "lodash": "^4.17.21",
    "loopback-connector-mongodb": "^6.3.0",
    "map-transform": "^0.3.12",
    "memory-cache": "^0.2.0",
    "moment": "^2.29.1",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "nodemon": "^3.1.7",
    "querystring": "^0.2.1",
    "redis": "^4.7.0",
    "stripe": "^17.4.0",
    "tslib": "^2.3.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@loopback/build": "^11.0.6",
    "@loopback/eslint-config": "^15.0.4",
    "@loopback/testlab": "^8.0.11",
    "@types/express-jwt": "^6.0.4",
    "@types/express-unless": "^2.0.1",
    "@types/jsdom": "^28.0.1",
    "@types/lodash": "4.17.5",
    "@types/multer": "^2.1.0",
    "@types/node": "^16.18.101",
    "@types/node-cron": "^3.0.11",
    "eslint": "^8.57.0",
    "source-map-support": "^0.5.21",
    "typescript": "~5.2.2"
  }
}
